# FILE: /.env.example
# SplashEstate CRM - Environment Configuration
# Copy this file to .env (chmod 600) and update it for your environment.
# Values are read once per request by config/config.php; "true"/"false" become booleans.

# Database
DB_HOST=localhost
DB_NAME=splashestate_crm
DB_USER=splashestate
DB_PASS=

# Application
APP_NAME="SplashEstate CRM"
# development | production (development relaxes webhook URL checks for local endpoints)
APP_ENV=development
APP_DEBUG=true
BASE_URL=http://localhost/SplashEstateCRM/public
APP_TIMEZONE=UTC

# Session (seconds of inactivity)
SESSION_LIFETIME=7200

# Uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Email
# MAIL_DRIVER: log  = write every email to storage/logs/mail.log (recommended for development)
#              smtp = send through the SMTP server below
#              mail = PHP mail()
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# tls = STARTTLS (port 587), ssl = implicit TLS (port 465), none = plain (local relays only)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="SplashEstate CRM"

# Stripe billing - leave STRIPE_SECRET_KEY empty for demo mode
# (plan changes are recorded locally, no payment is taken).
# Webhook endpoint to configure in the Stripe dashboard: <BASE_URL>/subscription/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted,
#         invoice.paid, invoice.payment_failed
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Shared secret for the HTTP cron endpoint (empty = CLI cron only)
CRON_SECRET=

# Token for GET /health/detailed from monitoring (min. 16 characters, sent as
# "Authorization: Bearer <token>"); empty = platform admins only
HEALTH_TOKEN=
